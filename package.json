{
  "name": "gesture-web-instrument",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @instrument/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/domain && tsc -p packages/web && tsc -p packages/server",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:api": "npm run build -w @instrument/server",
    "docs": "typedoc"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
