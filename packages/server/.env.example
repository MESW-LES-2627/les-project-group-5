# Database connection for the server
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Address of the web app, used for the links in emails (no trailing "/").
# Optional locally: it defaults to the Vite dev server, http://localhost:5173.
# APP_BASE_URL=http://localhost:5173

# Email account that sends real emails (account confirmation, password reset). Gmail by default.
# Optional locally: without EMAIL_USER and EMAIL_PASS, emails are only written to the [server] log.
# For Gmail, EMAIL_PASS is an App Password (https://myaccount.google.com/apppasswords), not the normal password.
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Instrument <you@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
